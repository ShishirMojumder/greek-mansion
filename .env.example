# Greek Mansion — environment variables
# Copy to .env.local for local dev. Add the same keys in Vercel → Project → Settings → Environment Variables.
# .env* files are git-ignored. NEVER commit real keys.

# --- Supabase ---------------------------------------------------------------
# Supabase dashboard → Project Settings → API

# Public. Safe to expose to the browser. Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# SECRET. Server-only. Never prefix with NEXT_PUBLIC. Bypasses RLS.
# Used by the seed / create-admin scripts and the nightly sold-out reset cron route.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-SECRET-KEY

# SECRET. Any random string. Vercel Cron sends it; the reset route rejects requests without it.
CRON_SECRET=YOUR-RANDOM-CRON-SECRET

# --- Telegram alerts (catering enquiries) -----------------------------------
# Optional. Leave blank and enquiries still save to the database — only the
# instant phone alert is skipped.
#
# 1. Telegram → message @BotFather → /newbot → copy the token below
# 2. The restaurant opens a chat with the new bot and sends it any message
# 3. npm run telegram:setup            → prints the chat id to paste below
# 4. npm run telegram:setup -- --test  → confirms the alert arrives

# SECRET. Server-only.
TELEGRAM_BOT_TOKEN=

# Comma-separated for several recipients, e.g. 123456789,987654321
TELEGRAM_CHAT_ID=

# Used for the "Open in admin" link inside the alert.
NEXT_PUBLIC_SITE_URL=https://greekmansion.ca
