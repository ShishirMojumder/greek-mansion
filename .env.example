# Greek Mansion — environment variables
# Copy to .env.local for local dev. Add the same keys in Vercel → Project → Settings → Environment Variables.
# .env* files are git-ignored. NEVER commit real keys.

# --- Supabase ---------------------------------------------------------------
# Supabase dashboard → Project Settings → API

# Public. Safe to expose to the browser. Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# SECRET. Server-only. Never prefix with NEXT_PUBLIC. Bypasses RLS.
# Used by the seed / create-admin scripts and the nightly sold-out reset cron route.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-SECRET-KEY

# SECRET. Any random string. Vercel Cron sends it; the reset route rejects requests without it.
CRON_SECRET=YOUR-RANDOM-CRON-SECRET
